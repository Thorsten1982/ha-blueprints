blueprint:
  name: PM-Lichtsteuerung mit manuellem Override (Final) 💡
  description: |
    Steuert ein Licht basierend auf dem Zustand eines Präsenzmelders, inklusive einer robusten
    manuellen Überschreibungsmöglichkeit (Override) und Helligkeitsbedingung (Lux).
  domain: automation
  
  input:
    light_entity:
      name: Licht-Entität
      description: Die Entität des Lichts, das gesteuert werden soll (z.B. light.bad_licht).
      selector:
        entity:
          domain: light
          
    presence_sensor:
      name: Präsenz-/Bewegungsmelder
      description: Die binary_sensor Entität, die die Anwesenheit meldet.
      selector:
        entity:
          domain: binary_sensor
          
    override_helper:
      name: Override Helper (input_boolean)
      description: Ein input_boolean zur Speicherung des manuellen Override-Zustands.
      selector:
        entity:
          domain: input_boolean
          
    no_presence_delay:
      name: Verzögerung bei Abwesenheit
      description: Wie lange das Licht nach Ende der Präsenz noch an bleiben soll.
      default:
        minutes: 1
      selector:
        duration:
        
    turn_on_action:
      name: Aktion beim Einschalten
      description: Die genaue Aktion, um das Licht einzuschalten.
      default:
        - service: light.turn_on
          target: !input light_entity
          data:
            brightness_pct: 100
      selector:
        action: {}

    lux_sensor:
      name: Helligkeitssensor (Lux)
      description: Der Sensor, der die Umgebungshelligkeit (Lux) misst.
      selector:
        entity:
          domain: sensor
          multiple: false
          
    lux_threshold:
      name: Lux-Schwellenwert (Licht AN)
      description: Das Licht wird nur eingeschaltet, wenn die Helligkeit UNTER diesem Wert liegt (z.B. 50 lx).
      default: 50
      selector:
        number:
          min: 0
          max: 1000
          unit_of_measurement: "lx"

mode: restart

variables:
  licht_entitaet: !input light_entity
  praesenz_melder: !input presence_sensor
  override_schalter: !input override_helper
  einschalt_aktion: !input turn_on_action
  lux_entitaet: !input lux_sensor
  lux_schwelle: !input lux_threshold

trigger:
  # T0: PM wird AN -> Licht AN (wenn Override AUS)
  - platform: state
    entity_id: !input presence_sensor
    to: 'on'
    id: 'pm_an'

  # T1: PM wird AUS (nach Delay) -> Licht AUS (wenn Override AUS)
  - platform: state
    entity_id: !input presence_sensor
    to: 'off'
    for: !input no_presence_delay
    id: 'pm_aus'

  # T2: Licht wird AUS -> Override AUS
  - platform: state
    entity_id: !input light_entity
    to: 'off'
    id: 'licht_aus'

  # T3: Licht wird AN -> Override AN (manuell)
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

action:
  - choose:
      # 0. PM AN (T0) 🟢 - Schaltet das Licht durch Präsenz ein
      - conditions:
          - condition: trigger
            id: 'pm_an'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
          - condition: state
            entity_id: !input light_entity
            state: 'off'
          - condition: numeric_state
            entity_id: !input lux_sensor
            below: !input lux_threshold
        sequence: !input turn_on_action

      # 1. PM AUS (T1) 🔴 - Schaltet das Licht durch Abwesenheit aus
      - conditions:
          - condition: trigger
            id: 'pm_aus'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          - service: light.turn_off
            target:
              entity_id: !input light_entity

      # 2. LICHT AUS (T2) 🔄 - Deaktiviert den Override
      - conditions:
          - condition: trigger
            id: 'licht_aus'
          - condition: state
            entity_id: !input override_helper
            state: 'on'
        sequence:
          - service: input_boolean.turn_off
            target:
              entity_id: !input override_helper

      # 3. MANUELL AN (T3) 👆 - Aktiviert den Override (FINALSTE LOGIK)
      - conditions:
          - condition: trigger
            id: 'manuell_an'
          # Prüft, ob der Präsenzmelder NICHT AN war, als das Licht eingeschaltet wurde.
          # Dies schließt T0 (die automatische Schaltung) aus.
          - condition: not
            conditions:
              - condition: state
                entity_id: !input presence_sensor
                state: 'on'
              
        sequence:
          # Override AN
          - service: input_boolean.turn_on
            target:
              entity_id: !input override_helper
