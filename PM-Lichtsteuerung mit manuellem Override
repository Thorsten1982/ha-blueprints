blueprint:
  name: PM-Licht mit Manuellem Override (2s-Stabil)
  description: |
    Steuert ein Licht über einen Präsenzmelder.
    - Erkennt Bewegung -> Führt die gewählte 'Einschalt-Aktion' aus.
    - Manuell eingeschaltet -> Bleibt dauerhaft AN (Override), bis manuell ausgeschaltet.
    (Nutzt 2-Sekunden-Zeitfenster zur Abwehr von Selbstauslösung)
  domain: automation
  input:
    light_entity:
      name: Zu überwachende Lampe (Licht/Schalter)
      selector:
        entity:
          domain: [light, switch]
    presence_sensor:
      name: Präsenzmelder (PM)
      selector:
        entity:
          domain: binary_sensor
    no_presence_delay:
      name: Ausschalt-Verzögerung
      default:
        minutes: 5
      selector:
        duration:
    override_helper:
      name: Override-Schalter (Input_Boolean Helfer)
      description: Der Helfer, der anzeigt, ob manuell eingeschaltet wurde.
      selector:
        entity:
          domain: input_boolean
    turn_on_action:
      name: Aktion bei Bewegung (Licht an / Szene)
      description: Was soll passieren, wenn der PM auslöst?
      default: []
      selector:
        action: {}

mode: restart
max_exceeded: silent

variables:
  licht_entitaet: !input light_entity
  praesenz_melder: !input presence_sensor
  override_schalter: !input override_helper

trigger:
  # T1: Präsenz erkannt (PM schaltet ein)
  - platform: state
    entity_id: !input presence_sensor
    from: 'off'
    to: 'on'
    id: 'praesenz_start'

  # T2: Keine Präsenz mehr (Ausschalten nach Verzögerung)
  - platform: state
    entity_id: !input presence_sensor
    from: 'on'
    to: 'off'
    for: !input no_presence_delay
    id: 'praesenz_ende'

  # T3: Licht geht AN (Prüfung auf Override-Aktivierung)
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

  # T4: Licht geht AUS (Override Reset)
  - platform: state
    entity_id: !input light_entity
    from: 'on'
    to: 'off'
    id: 'manuell_aus'

action:
  - choose:
      # -------------------------------------------------------------
      # 1. PRÄSENZ START (T1) 🟢
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_start'
        sequence:
          # Führt die gewünschte Einschalt-Aktion (Helligkeit/Szene) aus
          - choose:
            - conditions: "{{ true }}"
              sequence: !input turn_on_action
          # Deaktiviert den Override, da das Licht nun automatisch läuft
          - service: input_boolean.turn_off
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # 2. PRÄSENZ ENDE (T2) 🔴
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_ende'
          # Schaltet nur aus, wenn der Helfer AUS ist
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          - service: homeassistant.turn_off
            entity_id: !input light_entity

      # -------------------------------------------------------------
      # 3. MANUELL AN (T3) 👆 - 2-Sekunden-Puffer
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_an'
          # Der Override wird NUR DANN NICHT gesetzt, wenn:
          # (PM ist AN) UND (PM-Statusänderung war vor < 2 Sekunden)
          # -> Alles außerhalb dieses kurzen Fensters gilt als Manuell!
          - condition: template
            value_template: >
              {{ 
                not (
                  is_state(praesenz_melder, 'on') 
                  and 
                  (as_timestamp(now()) - as_timestamp(states[praesenz_melder].last_changed) < 2) 
                ) 
              }}
        sequence:
          # Aktiviert den Override
          - service: input_boolean.turn_on
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # 4. MANUELL AUS (T4) 💡
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_aus'
        sequence:
          # Setzt den Override zurück
          - service: input_boolean.turn_off
            entity_id: !input override_helper
