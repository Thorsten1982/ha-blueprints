blueprint:
  name: PM-Licht mit Override & Wunsch-Helligkeit/Szene
  description: >
    Steuert ein Licht über einen Präsenzmelder.
    - Erkennt Bewegung -> Führt die gewählte 'Einschalt-Aktion' aus (z.B. Szene oder gedimmtes Licht).
    - Manuell eingeschaltet -> Bleibt dauerhaft AN (Override), bis manuell ausgeschaltet.
  domain: automation
  input:
    light_entity:
      name: Zu überwachende Lampe (Trigger)
      description: Die Lampe, deren Zustand (An/Aus) für den Override überwacht wird.
      selector:
        entity:
          domain: [light, switch]
    presence_sensor:
      name: Präsenzmelder (PM)
      selector:
        entity:
          domain: binary_sensor
    no_presence_delay:
      name: Ausschalt-Verzögerung
      description: Zeit nach der letzten Bewegung, bis ausgeschaltet wird.
      default:
        minutes: 5
      selector:
        duration:
    override_helper:
      name: Override-Schalter (Helfer)
      description: Der Input Boolean, der den manuellen Status speichert.
      selector:
        entity:
          domain: input_boolean
    # NEU: Hier definieren Sie, WIE das Licht angeht
    turn_on_action:
      name: Aktion bei Bewegung (Licht an / Szene)
      description: >
        Hier definieren, was passieren soll, wenn Bewegung erkannt wird.
        Wählen Sie hier 'Dienst ausführen: Szene aktivieren' ODER 'Gerät: Lampe einschalten' (dort können Sie Helligkeit/Farbe setzen).
      default: []
      selector:
        action: {}

mode: restart
max_exceeded: silent

trigger:
  # T1: Präsenz erkannt
  - platform: state
    entity_id: !input presence_sensor
    from: 'off'
    to: 'on'
    id: 'praesenz_start'

  # T2: Keine Präsenz mehr
  - platform: state
    entity_id: !input presence_sensor
    from: 'on'
    to: 'off'
    for: !input no_presence_delay
    id: 'praesenz_ende'

  # T3: Licht manuell AN (Override aktivieren)
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

  # T4: Licht manuell AUS (Override deaktivieren)
  - platform: state
    entity_id: !input light_entity
    from: 'on'
    to: 'off'
    id: 'manuell_aus'

action:
  - choose:
      # -------------------------------------------------------------
      # 1. PRÄSENZ START -> Ihre definierte Aktion ausführen + Override AUS
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_start'
        sequence:
          # Hier wird Ihre Wunsch-Einstellung (Szene/Farbe) ausgeführt:
          - choose:
            - conditions: "{{ true }}"
              sequence: !input turn_on_action
          # Sicherstellen, dass Override aus ist
          - service: input_boolean.turn_off
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # 2. PRÄSENZ ENDE -> Licht AUS (Nur wenn Override AUS)
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_ende'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          - service: homeassistant.turn_off
            entity_id: !input light_entity

      # -------------------------------------------------------------
      # 3. MANUELL AN -> Override AN
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_an'
          # Schutz vor Schleife: Nur wenn NICHT durch Automation ausgelöst
          - condition: template
            value_template: "{{ trigger.to_state.context.parent_id is none or (trigger.to_state.context.user_id is not none) }}"
        sequence:
          - service: input_boolean.turn_on
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # 4. MANUELL AUS -> Override AUS
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_aus'
          - condition: template
            value_template: "{{ trigger.to_state.context.parent_id is none or (trigger.to_state.context.user_id is not none) }}"
        sequence:
          - service: input_boolean.turn_off
            entity_id: !input override_helper
