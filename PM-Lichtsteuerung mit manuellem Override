blueprint:
  name: PM-Lichtsteuerung mit manuellem Override 💡
  description: Steuert ein Licht basierend auf dem Zustand eines Präsenzmelders, inklusive einer robusten manuellen Überschreibungsmöglichkeit (Override).
  domain: automation
  # Achtung: Pfad in Ihrem HA kann abweichen, wenn Sie das Blueprint umbenannt haben
  # source_url: https://ihre-home-assistant-instanz/blueprints/Thorsten1982/PM-Lichtsteuerung-mit-manuellem-Override.yaml 
  
  input:
    light_entity:
      name: Licht-Entität
      description: Die Entität des Lichts, das gesteuert werden soll (z.B. light.bad_licht).
      selector:
        entity:
          domain: light
    presence_sensor:
      name: Präsenz-/Bewegungsmelder
      description: Die binary_sensor Entität, die die Anwesenheit meldet (z.B. binary_sensor.pm_bad).
      selector:
        entity:
          domain: binary_sensor
          device_class: presence
    override_helper:
      name: Override Helper (input_boolean)
      description: Ein input_boolean zur Speicherung des manuellen Override-Zustands (z.B. input_boolean.override_bad_licht).
      selector:
        entity:
          domain: input_boolean
    no_presence_delay:
      name: Verzögerung bei Abwesenheit
      description: Wie lange das Licht nach Ende der Präsenz noch an bleiben soll.
      default:
        minutes: 1
      selector:
        duration:
    turn_on_action:
      name: Aktion beim Einschalten
      description: Die genaue Aktion, um das Licht einzuschalten (z.B. mit Helligkeit/Farbe/Effekt).
      default:
        - service: light.turn_on
          target: !input light_entity
          data:
            brightness_pct: 100
      selector:
        action:

mode: restart

variables:
  licht_entitaet: !input light_entity
  praesenz_melder: !input presence_sensor
  override_schalter: !input override_helper
  einschalt_aktion: !input turn_on_action

trigger:
  # T0: PM wird AN -> Licht AN (wenn Override AUS)
  - platform: state
    entity_id: !input presence_sensor
    to: 'on'
    id: 'pm_an'

  # T1: PM wird AUS (nach Delay) -> Licht AUS (wenn Override AUS)
  - platform: state
    entity_id: !input presence_sensor
    to: 'off'
    for: !input no_presence_delay
    id: 'pm_aus'

  # T2: Licht wird AUS -> Override AUS
  - platform: state
    entity_id: !input light_entity
    to: 'off'
    id: 'licht_aus'

  # T3: Licht wird AN -> Override AN (manuell)
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

action:
  - choose:
      # 0. PM AN (T0) 🟢 - Schaltet das Licht durch Präsenz ein
      - conditions:
          - condition: trigger
            id: 'pm_an'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
          - condition: state
            entity_id: !input light_entity
            state: 'off'
        sequence: !input turn_on_action

      # 1. PM AUS (T1) 🔴 - Schaltet das Licht durch Abwesenheit aus
      - conditions:
          - condition: trigger
            id: 'pm_aus'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          - service: light.turn_off
            target:
              entity_id: !input light_entity

      # 2. LICHT AUS (T2) 🔄 - Deaktiviert den Override (manuell oder durch PM)
      - conditions:
          - condition: trigger
            id: 'licht_aus'
          # Deaktiviert den Override, wenn das Licht AUS ist UND der Override noch AN ist.
          - condition: state
            entity_id: !input override_helper
            state: 'on'
        sequence:
          - service: input_boolean.turn_off
            target:
              entity_id: !input override_helper

      # 3. MANUELL AN (T3) 👆 - Aktiviert den Override
      - conditions:
          - condition: trigger
            id: 'manuell_an'
          - condition: template
            value_template: >
              {% set is_auto_on_by_t0 = 
                  
                  (trigger.to_state.context.user_id is none) and 
                  is_state(praesenz_melder, 'on') and 
                  is_state(override_schalter, 'off') 
              %}
              
              
              {{ not is_auto_on_by_t0 }}
              
        sequence:
          # Aktiviert den Override
          - service: input_boolean.turn_on
            target:
              entity_id: !input override_helper
