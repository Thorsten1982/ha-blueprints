blueprint:
  name: Präsenz-Licht mit Manuellem Override (Fixed)
  description: >
    Steuert ein Licht über einen Präsenzmelder. 
    Wird das Licht manuell eingeschaltet, bleibt es dauerhaft an (Override), 
    bis es manuell wieder ausgeschaltet wird.
  domain: automation
  input:
    light_entity:
      name: Zu steuerndes Licht
      selector:
        entity:
          domain: [light, switch]
    presence_sensor:
      name: Präsenzmelder (PM)
      selector:
        entity:
          domain: binary_sensor
    no_presence_delay:
      name: Ausschalt-Verzögerung
      description: Zeit nach der letzten Bewegung, bis ausgeschaltet wird.
      default:
        minutes: 5
      selector:
        duration:
    override_helper:
      name: Override-Schalter (Input Boolean)
      description: Muss ein existierender Helfer (Toggle) sein!
      selector:
        entity:
          domain: input_boolean

mode: restart
max_exceeded: silent

trigger:
  # T1: Präsenz erkannt
  - platform: state
    entity_id: !input presence_sensor
    from: 'off'
    to: 'on'
    id: 'praesenz_start'

  # T2: Keine Präsenz mehr (mit Zeitverzögerung)
  - platform: state
    entity_id: !input presence_sensor
    from: 'on'
    to: 'off'
    for: !input no_presence_delay
    id: 'praesenz_ende'

  # T3: Licht manuell AN
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

  # T4: Licht manuell AUS
  - platform: state
    entity_id: !input light_entity
    from: 'on'
    to: 'off'
    id: 'manuell_aus'

action:
  - choose:
      # -------------------------------------------------------------
      # Szenario 1: PM erkennt Bewegung -> Licht AN + Override AUS
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_start'
        sequence:
          - service: homeassistant.turn_on
            entity_id: !input light_entity
          - service: input_boolean.turn_off
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # Szenario 2: Keine Bewegung mehr -> Licht AUS (Nur wenn Override AUS ist)
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_ende'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          - service: homeassistant.turn_off
            entity_id: !input light_entity

      # -------------------------------------------------------------
      # Szenario 3: Licht Manuell eingeschaltet -> Override AN
      # WICHTIG: Wir prüfen den Kontext, um Endlosschleifen zu vermeiden
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_an'
          - condition: template
            value_template: "{{ trigger.to_state.context.parent_id is none or (trigger.to_state.context.user_id is not none) }}"
        sequence:
          - service: input_boolean.turn_on
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # Szenario 4: Licht Manuell ausgeschaltet -> Override AUS
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_aus'
          - condition: template
            value_template: "{{ trigger.to_state.context.parent_id is none or (trigger.to_state.context.user_id is not none) }}"
        sequence:
          - service: input_boolean.turn_off
            entity_id: !input override_helper
