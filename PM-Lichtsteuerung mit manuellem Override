blueprint:
  name: Präsenz-Licht mit Manuellem Override (Gärtner-Spezial)
  description: |
    Steuert ein Licht über einen Präsenzmelder. 
    Wird das Licht manuell eingeschaltet, bleibt es dauerhaft an (Override), 
    bis es manuell wieder ausgeschaltet wird.
  domain: automation
  source_url: https://ihre-quelle.de/praesenz_override.yaml # Ersetzen Sie dies optional

  input:
    light_entity:
      name: Zu steuerndes Licht
      description: Das Licht/der Schalter, das automatisch und manuell gesteuert wird.
      selector:
        entity:
          domain: [light, switch]
    presence_sensor:
      name: Präsenzmelder (PM)
      description: Der binäre Sensor, der die An- oder Abwesenheit meldet.
      selector:
        entity:
          domain: binary_sensor
    no_presence_delay:
      name: Ausschalt-Verzögerung
      description: Wie lange nach 'keiner Präsenz' soll das Licht ausgeschaltet werden?
      default: '00:05:00'
      selector:
        duration:
    override_helper:
      name: Override-Schalter (Input Boolean Helfer)
      description: Ein dedizierter Helfer (Toggle) zur Speicherung des Override-Zustands. MUSS VORHER ERSTELLT WERDEN!
      selector:
        entity:
          domain: input_boolean

mode: single
max_exceeded: silent

variables:
  licht_entitaet: !input light_entity
  praesenz_melder: !input presence_sensor
  override_schalter: !input override_helper
  ausschalt_verzoegerung: !input no_presence_delay

trigger:
  # T1: Präsenz erkannt -> Licht AN (Basis-Funktion)
  - platform: state
    entity_id: '[[ praesenz_melder ]]'
    from: 'off'
    to: 'on'
    id: 'praesenz_start'

  # T2: Keine Präsenz mehr -> Ausschalten versuchen
  - platform: state
    entity_id: '[[ praesenz_melder ]]'
    from: 'on'
    to: 'off'
    for: '[[ ausschalt_verzoegerung ]]'
