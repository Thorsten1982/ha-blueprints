blueprint:
  name: PM-Licht mit Manuellem Override (Final V9.7)
  description: |
    Steuert ein Licht über einen Präsenzmelder.
    - Erkennt Bewegung -> Führt die gewählte 'Einschalt-Aktion' aus.
    - Manuell eingeschaltet (App ODER Taster) -> Bleibt AN (Override).
    (Modus: Queued zur Vermeidung von Race Conditions)
  domain: automation
  input:
    light_entity:
      name: Zu überwachende Lampe (Licht/Schalter)
      selector:
        entity:
          domain: [light, switch]
    presence_sensor:
      name: Präsenzmelder (PM)
      selector:
        entity:
          domain: binary_sensor
    no_presence_delay:
      name: Ausschalt-Verzögerung
      default:
        minutes: 5
      selector:
        duration:
    override_helper:
      name: Override-Schalter (Input_Boolean Helfer)
      description: Der Helfer, der anzeigt, ob manuell eingeschaltet wurde.
      selector:
        entity:
          domain: input_boolean
    turn_on_action:
      name: Aktion bei Bewegung (Licht an / Szene)
      description: Was soll passieren, wenn der PM auslöst?
      default: []
      selector:
        action: {}

mode: queued
max_exceeded: silent

variables:
  licht_entitaet: !input light_entity
  praesenz_melder: !input presence_sensor
  override_schalter: !input override_helper

trigger:
  # T1: Präsenz erkannt (PM schaltet ein)
  - platform: state
    entity_id: !input presence_sensor
    from: 'off'
    to: 'on'
    id: 'praesenz_start'

  # T2: Keine Präsenz mehr (Ausschalten nach Verzögerung)
  - platform: state
    entity_id: !input presence_sensor
    from: 'on'
    to: 'off'
    for: !input no_presence_delay
    id: 'praesenz_ende'

  # T3: Licht geht AN (Prüfung auf Override-Aktivierung)
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

  # T4: Licht geht AUS (Override Reset)
  - platform: state
    entity_id: !input light_entity
    from: 'on'
    to: 'off'
    id: 'manuell_aus'

action:
  - choose:
      # -------------------------------------------------------------
      # 1. PRÄSENZ START (T1) 🟢 - PM Schaltet EIN
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_start'
          # WICHTIG: PM schaltet nur ein, wenn kein manueller Override aktiv ist.
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          # Führt die gewünschte Einschalt-Aktion aus
          - alias: "Licht über PM einschalten"
            sequence: !input turn_on_action
          
          # Der Override-Helfer bleibt auf AUS, da die Automatisierung nun die Kontrolle hat.

      # -------------------------------------------------------------
      # 2. PRÄSENZ ENDE (T2) 🔴 - PM Schaltet AUS
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_ende'
          # Schaltet nur aus, wenn der Helfer AUS ist.
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          - service: homeassistant.turn_off
            entity_id: !input light_entity

      # -------------------------------------------------------------
      # 3. MANUELL AN (T3) 👆 - Aktiviert den Override
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_an'
          - condition: template
            # Wenn per App/UI eingeschaltet ODER wenn die Automatisierung
            # NICHT in den letzten 60 Sekunden gelaufen ist (um T4-Fehler zu vermeiden).
            value_template: >
              {{ 
                trigger.to_state.context.user_id is not none or 
                state_attr(this.entity_id, 'last_triggered') is none or 
                (as_timestamp(now()) - as_timestamp(state_attr(this.entity_id, 'last_triggered'))) > 60.0 
              }}
        sequence:
          # Aktiviert den Override
          - service: input_boolean.turn_on
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # 4. MANUELL AUS (T4) 💡 - Setzt Override zurück
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_aus'
        sequence:
          # Setzt den Override zurück
          - service: input_boolean.turn_off
            entity_id: !input override_helper
