blueprint:
  name: PM-Lichtsteuerung mit manuellem Override (Robust) 💡
  description: |
    Steuert ein Licht basierend auf dem Zustand eines Präsenzmelders, inklusive einer robusten
    manuellen Überschreibungsmöglichkeit (Override) UND einer Helligkeitsbedingung (Lux).
    Das Licht wird nur bei Präsenz eingeschaltet, wenn der Lux-Wert unter einem Schwellenwert liegt.
  domain: automation
  
  input:
    light_entity:
      name: Licht-Entität
      description: Die Entität des Lichts, das gesteuert werden soll (z.B. light.bad_licht).
      selector:
        entity:
          domain: light
          
    presence_sensor:
      name: Präsenz-/Bewegungsmelder
      description: Die binary_sensor Entität, die die Anwesenheit meldet (z.B. binary_sensor.pm_bad).
      selector:
        entity:
          domain: binary_sensor
          # Korrektur: device_class: presence entfernt, um UI-Fehler zu vermeiden
          
    override_helper:
      name: Override Helper (input_boolean)
      description: Ein input_boolean zur Speicherung des manuellen Override-Zustands (z.B. input_boolean.override_bad_licht).
      selector:
        entity:
          domain: input_boolean
          
    no_presence_delay:
      name: Verzögerung bei Abwesenheit
      description: Wie lange das Licht nach Ende der Präsenz noch an bleiben soll.
      default:
        minutes: 1
      selector:
        duration:
        
    turn_on_action:
      name: Aktion beim Einschalten
      description: Die genaue Aktion, um das Licht einzuschalten (z.B. mit Helligkeit/Farbe/Effekt).
      default:
        - service: light.turn_on
          target: !input light_entity
          data:
            brightness_pct: 100
      selector:
        action: {}

    lux_sensor:
      name: Helligkeitssensor (Lux)
      description: Der Sensor, der die Umgebungshelligkeit (Lux) misst.
      selector:
        entity:
          domain: sensor
          # Korrektur: device_class: illuminance entfernt, um UI-Fehler zu vermeiden
          multiple: false
          
    lux_threshold:
      name: Lux-Schwellenwert (Licht AN)
      description: Die Obergrenze in Lux. Das Licht wird nur eingeschaltet, wenn die Helligkeit UNTER diesem Wert liegt (z.B. 50 lx).
      default: 50
      selector:
        number:
          min: 0
          max: 1000
          unit_of_measurement: "lx"

mode: restart

variables:
  licht_entitaet: !input light_entity
  praesenz_melder: !input presence_sensor
  override_schalter: !input override_helper
  einschalt_aktion: !input turn_on_action
  lux_entitaet: !input lux_sensor
  lux_schwelle: !input lux_threshold

trigger:
  # T0: PM wird AN -> Licht AN (wenn Override AUS)
  - platform: state
    entity_id: !input presence_sensor
    to: 'on'
    id: 'pm_an'

  # T1: PM wird AUS (nach Delay) -> Licht AUS (wenn Override AUS)
  - platform: state
    entity_id: !input presence_sensor
    to: 'off'
    for: !input no_presence_delay
    id: 'pm_aus'

  # T2: Licht wird AUS -> Override AUS
  - platform: state
    entity_id: !input light_entity
    to: 'off'
    id: 'licht_aus'

  # T3: Licht wird AN -> Override AN (manuell)
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

action:
  - choose:
      # 0. PM AN (T0) 🟢 - Schaltet das Licht durch Präsenz ein
      - conditions:
          - condition: trigger
            id: 'pm_an'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
          - condition: state
            entity_id: !input light_entity
            state: 'off'
          - condition: numeric_state
            entity_id: !input lux_sensor
            below: !input lux_threshold
        sequence: !input turn_on_action

      # 1. PM AUS (T1) 🔴 - Schaltet das Licht durch Abwesenheit aus
      - conditions:
          - condition: trigger
            id: 'pm_aus'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          - service: light.turn_off
            target:
              entity_id: !input light_entity

      # 2. LICHT AUS (T2) 🔄 - Deaktiviert den Override (manuell oder durch T1)
      - conditions:
          - condition: trigger
            id: 'licht_aus'
          - condition: state
            entity_id: !input override_helper
            state: 'on'
        sequence:
          - service: input_boolean.turn_off
            target:
              entity_id: !input override_helper

      # 3. MANUELL AN (T3) 👆 - Aktiviert den Override (FINALE, ROBUSTE LOGIK)
      - conditions:
          - condition: trigger
            id: 'manuell_an'
          - condition: or # ODER-Verknüpfung: Wenn A oder B wahr ist, dann ist es manuell
            conditions:
              # Bedingung A: Geschaltet von einem Benutzer (UI/App/Sprachbefehl).
              # Hat immer eine user_id.
              - condition: template
                value_template: >
                  {{ trigger.to_state.context.user_id is not none }}
                  
              # Bedingung B: Geschaltet von einer anderen Entität ODER der Kontext ist NULL (Physischer Taster).
              # Da der Context-Wert oft null ist, muss er UNGLEICH der eigenen Automatisierungs-ID sein (this.entity_id).
              - condition: template
                value_template: >
                  {{ trigger.to_state.context.entity_id != this.entity_id }}
              
        sequence:
          # Aktiviert den Override
          - service: input_boolean.turn_on
            target:
              entity_id: !input override_helper
