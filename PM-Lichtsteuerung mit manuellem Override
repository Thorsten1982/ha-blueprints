blueprint:
  name: PM-Lichtsteuerung mit manuellem Override (V10 - Zeit-Logik) 💡
  description: >
    Steuert ein Licht basierend auf Präsenz.
    - Override-Erkennung basierend auf Zeit-Korrelation (verhindert Fehler bei fehlenden Context-IDs).
    - Inklusive "Override Lock" (Taster drücken, wenn Licht schon an ist).
    
    Basiert auf Community-Konzepten zur Taster- und Präsenzsteuerung mit manueller Sperre.
  source_url: https://github.com/Thorsten1982/ha-blueprints/blob/main/pm_light_control.yaml
  domain: automation

  input:
    light_entity:
      name: Licht-Entität
      selector:
        entity:
          domain: light
          multiple: false
    presence_sensor:
      name: Präsenz-/Bewegungsmelder
      selector:
        entity:
          domain: binary_sensor
          multiple: false
    override_helper:
      name: Override Helper (input_boolean)
      selector:
        entity:
          domain: input_boolean
          multiple: false
    no_presence_delay:
      name: Verzögerung bei Abwesenheit
      default:
        minutes: 1
      selector:
        duration:
    turn_on_action:
      name: Aktion beim Einschalten
      default:
        - action: light.turn_on
          target: !input light_entity
          data:
            brightness_pct: 100
      selector:
        action: {}
    lux_sensor:
      name: Helligkeitssensor (Lux)
      selector:
        entity:
          domain: sensor
          multiple: false
    lux_threshold:
      name: Lux-Schwellenwert (Licht AN)
      default: 50
      selector:
        number:
          min: 0
          max: 1000
          unit_of_measurement: "lx"

mode: restart

variables:
  licht_entitaet: !input light_entity
  praesenz_melder: !input presence_sensor
  override_schalter: !input override_helper
  lux_entitaet: !input lux_sensor
  lux_schwelle: !input lux_threshold

trigger:
  # T0: PM wird AN (Automatik Start)
  - platform: state
    entity_id: !input presence_sensor
    to: 'on'
    id: 'pm_an'

  # T1: PM wird AUS (Automatik Ende)
  - platform: state
    entity_id: !input presence_sensor
    to: 'off'
    for: !input no_presence_delay
    id: 'pm_aus'

  # T2: Licht wird AUS (Reset)
  - platform: state
    entity_id: !input light_entity
    to: 'off'
    id: 'licht_aus'

  # T3: Licht wird AN (Prüfung auf Override)
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

  # T4: Override Lock (Taster drücken während Licht schon AN ist)
  - platform: state
    entity_id: !input light_entity
    from: 'on'
    to: 'on'
    id: 'manuell_lock'

action:
  - choose:
      # ----------------------------------------------------------------
      # 0. PM AN (T0) -> Automatisches Einschalten
      # ----------------------------------------------------------------
      - conditions
