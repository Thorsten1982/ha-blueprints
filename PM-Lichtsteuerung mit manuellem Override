blueprint:
  name: PM-Licht mit Manuellem Override (ID-Ausschluss)
  description: >
    Steuert ein Licht über einen Präsenzmelder.
    - Erkennt Bewegung -> Führt die gewählte 'Einschalt-Aktion' aus.
    - Manuell eingeschaltet (oder extern) -> Bleibt dauerhaft AN (Override), bis manuell ausgeschaltet.
    (Schließt nur die eigene Automatisierung als Auslöser aus)
  domain: automation
  input:
    light_entity:
      name: Zu überwachende Lampe (Trigger)
      selector:
        entity:
          domain: [light, switch]
    presence_sensor:
      name: Präsenzmelder (PM)
      selector:
        entity:
          domain: binary_sensor
    no_presence_delay:
      name: Ausschalt-Verzögerung
      default:
        minutes: 5
      selector:
        duration:
    override_helper:
      name: Override-Schalter (Helfer)
      description: Der Helfer, der anzeigt, ob manuell eingeschaltet wurde.
      selector:
        entity:
          domain: input_boolean
    turn_on_action:
      name: Aktion bei Bewegung (Licht an / Szene)
      description: Was soll passieren, wenn der PM auslöst?
      default: []
      selector:
        action: {}

mode: restart
max_exceeded: silent

variables:
  licht_entitaet: !input light_entity
  praesenz_melder: !input presence_sensor
  override_schalter: !input override_helper

trigger:
  # T1: Präsenz erkannt
  - platform: state
    entity_id: !input presence_sensor
    from: 'off'
    to: 'on'
    id: 'praesenz_start'

  # T2: Keine Präsenz mehr
  - platform: state
    entity_id: !input presence_sensor
    from: 'on'
    to: 'off'
    for: !input no_presence_delay
    id: 'praesenz_ende'

  # T3: Licht geht AN (Prüfung auf Override)
  - platform: state
    entity_id: !input light_entity
    from: 'off'
    to: 'on'
    id: 'manuell_an'

  # T4: Licht geht AUS (Override Reset)
  - platform: state
    entity_id: !input light_entity
    from: 'on'
    to: 'off'
    id: 'manuell_aus'

action:
  - choose:
      # -------------------------------------------------------------
      # 1. PRÄSENZ START (PM schaltet ein)
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_start'
        sequence:
          # Aktion ausführen (Licht an / Szene)
          - choose:
            - conditions: "{{ true }}"
              sequence: !input turn_on_action
          # Override ausschalten
          - service: input_boolean.turn_off
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # 2. PRÄSENZ ENDE (Ausschalten, wenn kein Override)
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'praesenz_ende'
          - condition: state
            entity_id: !input override_helper
            state: 'off'
        sequence:
          - service: homeassistant.turn_off
            entity_id: !input light_entity

      # -------------------------------------------------------------
      # 3. MANUELL AN (Die ID-Prüfung)
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_an'
          # Die Bedingung: Der Override wird nur dann AKTIVIERT, wenn die 'parent_id'
          # NICHT der ID dieser eigenen Automatisierung entspricht.
          - condition: template
            value_template: >
              {{ 
                (trigger.to_state.context.parent_id is none) 
                or 
                (trigger.to_state.context.parent_id != this.attributes.id) 
              }}
        sequence:
          - service: input_boolean.turn_on
            entity_id: !input override_helper

      # -------------------------------------------------------------
      # 4. MANUELL AUS (Reset)
      # -------------------------------------------------------------
      - conditions:
          - condition: trigger
            id: 'manuell_aus'
        sequence:
          - service: input_boolean.turn_off
            entity_id: !input override_helper
